<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:padding="10dp">

    <androidx.cardview.widget.CardView
        android:id="@+id/pc_card_container"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:cardBackgroundColor="#25000000"
        app:cardCornerRadius="@dimen/oneui_squircle_radius_large"
        app:cardElevation="0dp"
        app:cardMaxElevation="0dp">

        <RelativeLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_oneui_squircle_card"
            android:padding="16dp">

            <RelativeLayout
                android:id="@+id/grid_image_layout"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_centerHorizontal="true">

                <ImageView
                    android:id="@+id/grid_image"
                    android:layout_centerHorizontal="true"
                    android:layout_width="110dp"
                    android:layout_height="110dp" />

                <ImageView
                    android:id="@+id/grid_overlay"
                    android:layout_centerHorizontal="true"
                    android:layout_marginTop="24dp"
                    android:layout_width="46dp"
                    android:layout_height="46dp" />

                <ProgressBar
                    android:id="@+id/grid_spinner"
                    android:layout_centerHorizontal="true"
                    android:layout_marginTop="24dp"
                    android:layout_width="46dp"
                    android:layout_height="46dp"
                    android:indeterminate="true" />
            </RelativeLayout>

            <TextView
                android:id="@+id/grid_text"
                android:layout_width="125dp"
                android:layout_height="wrap_content"
                android:layout_below="@id/grid_image_layout"
                android:layout_marginTop="10dp"
                android:layout_centerHorizontal="true"
                android:gravity="center"
                android:textColor="#FFFFFF"
                android:textSize="16sp" />
        </RelativeLayout>
    </androidx.cardview.widget.CardView>
</RelativeLayout>