<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Specular rim brightest at top-left -->
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:angle="315"
                android:startColor="#5CFFFFFF"
                android:centerColor="#28FFFFFF"
                android:endColor="#14FFFFFF"
                android:type="linear" />
            <corners android:radius="@dimen/oneui_squircle_radius" />
        </shape>
    </item>
    <!-- Dark frosted pill surface for crisp legibility over scrolling cards -->
    <item
        android:top="1dp"
        android:left="1dp"
        android:right="0.5dp"
        android:bottom="0.5dp">
        <shape android:shape="rectangle">
            <gradient
                android:angle="315"
                android:startColor="#C4161E2E"
                android:endColor="#AD0D121D"
                android:type="linear" />
            <corners android:radius="@dimen/oneui_squircle_radius" />
        </shape>
    </item>
</layer-list>
