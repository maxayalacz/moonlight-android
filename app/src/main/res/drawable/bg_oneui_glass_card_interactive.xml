<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <solid android:color="#4029354C" />
            <stroke
                android:width="1.5dp"
                android:color="#7AFFFFFF" />
            <corners android:radius="@dimen/oneui_squircle_radius_large" />
        </shape>
    </item>
    <item android:state_focused="true">
        <shape android:shape="rectangle">
            <solid android:color="#3A263248" />
            <stroke
                android:width="1.5dp"
                android:color="#99FFFFFF" />
            <corners android:radius="@dimen/oneui_squircle_radius_large" />
        </shape>
    </item>
    <item android:state_selected="true">
        <shape android:shape="rectangle">
            <solid android:color="#36232F44" />
            <stroke
                android:width="1.5dp"
                android:color="#7AFFFFFF" />
            <corners android:radius="@dimen/oneui_squircle_radius_large" />
        </shape>
    </item>
    <item android:state_hovered="true">
        <shape android:shape="rectangle">
            <solid android:color="#32202B3F" />
            <stroke
                android:width="1.2dp"
                android:color="#5EFFFFFF" />
            <corners android:radius="@dimen/oneui_squircle_radius_large" />
        </shape>
    </item>
    <item android:drawable="@drawable/bg_oneui_squircle_card" />
</selector>
