<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Specular rim brightest at top-left -->
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:angle="315"
                android:startColor="#4DFFFFFF"
                android:centerColor="#1EFFFFFF"
                android:endColor="#10FFFFFF"
                android:type="linear" />
            <corners android:radius="@dimen/oneui_squircle_radius_large" />
        </shape>
    </item>
    <!-- Frosted dark glass card surface -->
    <item
        android:top="1dp"
        android:left="1dp"
        android:right="0.5dp"
        android:bottom="0.5dp">
        <shape android:shape="rectangle">
            <gradient
                android:angle="315"
                android:startColor="#3020293B"
                android:endColor="#20121722"
                android:type="linear" />
            <corners android:radius="@dimen/oneui_squircle_radius_large" />
        </shape>
    </item>
</layer-list>
