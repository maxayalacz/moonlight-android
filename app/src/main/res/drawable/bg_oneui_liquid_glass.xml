<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Specular rim brightest at top-left -->
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:angle="315"
                android:startColor="#55FFFFFF"
                android:centerColor="#22FFFFFF"
                android:endColor="#12FFFFFF"
                android:type="linear" />
            <corners android:radius="@dimen/oneui_squircle_radius" />
        </shape>
    </item>
    <!-- Frosted translucent glass fill -->
    <item
        android:top="1dp"
        android:left="1dp"
        android:right="0.5dp"
        android:bottom="0.5dp">
        <shape android:shape="rectangle">
            <gradient
                android:angle="315"
                android:startColor="#34263146"
                android:endColor="#22141A26"
                android:type="linear" />
            <corners android:radius="@dimen/oneui_squircle_radius" />
        </shape>
    </item>
</layer-list>
