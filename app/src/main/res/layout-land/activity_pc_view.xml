<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="@drawable/bg_oneui_ambient_surface"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".PcView" >

    <!-- One UI 9 Liquid Glass Side Navigation Drawer/Toolbar -->
    <LinearLayout
        android:id="@+id/pcToolbarContainer"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:layout_alignParentStart="true"
        android:layout_alignParentLeft="true"
        android:layout_centerVertical="true"
        android:layout_marginLeft="16dp"
        android:layout_marginStart="16dp"
        android:padding="8dp"
        android:elevation="4dp"
        android:background="@drawable/bg_oneui_liquid_glass">

        <ImageButton
            android:id="@+id/settingsButton"
            android:layout_width="56dp"
            android:layout_height="56dp"
            android:cropToPadding="false"
            android:scaleType="centerInside"
            android:padding="12dp"
            android:nextFocusForward="@id/helpButton"
            android:background="@drawable/bg_oneui_glass_icon_button"
            android:src="@drawable/ic_settings" />

        <ImageButton
            android:id="@+id/helpButton"
            android:layout_width="56dp"
            android:layout_height="56dp"
            android:layout_marginTop="4dp"
            android:cropToPadding="false"
            android:scaleType="centerInside"
            android:padding="12dp"
            android:nextFocusForward="@id/focusModeButton"
            android:background="@drawable/bg_oneui_glass_icon_button"
            android:src="@drawable/ic_help" />

        <ImageButton
            android:id="@+id/focusModeButton"
            android:layout_width="56dp"
            android:layout_height="56dp"
            android:layout_marginTop="4dp"
            android:cropToPadding="false"
            android:scaleType="centerInside"
            android:padding="12dp"
            android:nextFocusForward="@id/manuallyAddPc"
            android:background="@drawable/bg_oneui_glass_icon_button"
            android:contentDescription="@string/title_focus_mode"
            android:src="@drawable/ic_focus_mode" />

        <ImageButton
            android:id="@+id/manuallyAddPc"
            android:layout_width="56dp"
            android:layout_height="56dp"
            android:layout_marginTop="4dp"
            android:cropToPadding="false"
            android:scaleType="centerInside"
            android:padding="12dp"
            android:background="@drawable/bg_oneui_glass_icon_button"
            android:src="@drawable/ic_add" />

    </LinearLayout>

    <RelativeLayout
        android:id="@+id/pcFragmentContainer"
        android:layout_width="fill_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:layout_alignParentBottom="true"
        android:layout_alignParentTop="true"
        android:layout_toRightOf="@+id/pcToolbarContainer"
        android:layout_toEndOf="@+id/pcToolbarContainer">

        <RelativeLayout
            android:id="@+id/no_pc_found_layout"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_oneui_liquid_glass"
            android:elevation="4dp"
            android:padding="24dp"
            android:layout_centerVertical="true"
            android:layout_centerHorizontal="true">
            <ProgressBar
                android:id="@+id/pcs_loading"
                android:layout_width="64dp"
                android:layout_height="64dp"
                android:layout_centerVertical="true"
                android:indeterminate="true"/>
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_toRightOf="@+id/pcs_loading"
                android:layout_toEndOf="@+id/pcs_loading"
                android:layout_marginLeft="16dp"
                android:layout_marginStart="16dp"
                android:layout_centerVertical="true"
                android:textColor="#FFFFFF"
                android:textAppearance="?android:attr/textAppearanceLarge"
                android:gravity="center"
                android:text="@string/searching_pc"/>
        </RelativeLayout>

    </RelativeLayout>

    <RelativeLayout
        android:id="@+id/focusModeContainer"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_alignParentBottom="true"
        android:layout_alignParentTop="true"
        android:layout_toRightOf="@+id/pcToolbarContainer"
        android:layout_toEndOf="@+id/pcToolbarContainer"
        android:visibility="gone">

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/focusPagerRecycler"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clipToPadding="false"
            android:paddingTop="8dp"
            android:paddingBottom="40dp" />

        <LinearLayout
            android:id="@+id/focusPageIndicator"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentBottom="true"
            android:layout_centerHorizontal="true"
            android:layout_marginBottom="14dp"
            android:gravity="center"
            android:orientation="horizontal" />
    </RelativeLayout>

    <com.google.android.material.floatingactionbutton.ExtendedFloatingActionButton
        android:id="@+id/profilesButton"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_alignParentBottom="true"
        android:layout_alignParentEnd="true"
        android:layout_marginBottom="24dp"
        android:layout_marginEnd="24dp"
        android:contentDescription="@string/profile_manager_choose_profile"
        android:layout_margin="16dp"
        app:backgroundTint="#38253044"
        app:strokeColor="#52FFFFFF"
        app:strokeWidth="1dp"
        app:iconTint="#FFFFFF"
        app:elevation="6dp"
        app:shapeAppearanceOverlay="@style/ShapeAppearance.OneUI.Squircle"
        app:icon="@drawable/ic_profiles" />

</RelativeLayout>
